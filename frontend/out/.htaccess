# Senka Luxury Atelier — DirectoryIndex & Clean URL Rewrite Rules
DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# 1. Direct files or directories pass through directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Map clean URLs to .html files (e.g. /admin -> admin.html, /checkout -> checkout.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. Fallback to index.html for client-side router
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteCond %{REQUEST_URI} !^/index$
RewriteRule ^(.*)$ index.html [L]
