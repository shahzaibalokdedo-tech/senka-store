# Senka Luxury Atelier — Clean URL Rewrite Rules for Apache
RewriteEngine On
RewriteBase /

# 1. Direct files or directories pass through directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Map clean URLs to .html files (e.g. /admin -> admin.html, /checkout -> checkout.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. Fallback to index.html only if request is not an actual file
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteCond %{REQUEST_URI} !^/index$
RewriteRule ^(.*)$ index.html [L]
