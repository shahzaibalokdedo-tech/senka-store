# Senka Luxury Atelier — Clean URL & CDN Reverse Proxy Rewrite Rules
# Disable Apache DirectorySlash 301 redirect loop behind CDN proxies (StackCDN / Cloudflare)
DirectorySlash Off
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    # Prevent StackCDN edge servers from caching redirects or stale HTML
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
</IfModule>

RewriteEngine On
RewriteBase /

# 1. Direct files pass through directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Map root / to index.html directly
RewriteRule ^$ index.html [L]

# 3. Map clean URLs to .html files (e.g. /admin -> admin.html, /checkout -> checkout.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 4. Fallback to index.html for client-side router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L]
